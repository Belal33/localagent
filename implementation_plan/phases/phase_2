## Step 4: Upgrade LangGraph to a ReAct Tool-Calling Loop

Modify `src/lib/agent/graph.ts` to evolve from `START → agent → END` into a full ReAct agent: `START → agent ⇄ tools → END`.

### 4.1 Updated Graph — `src/lib/agent/graph.ts`

```typescript
import {
  StateGraph,
  MessagesAnnotation,
  MemorySaver,
} from "@langchain/langgraph";
import { ToolNode } from "@langchain/langgraph/prebuilt";
import { ChatOllama } from "@langchain/ollama";
import { SystemMessage, AIMessage } from "@langchain/core/messages";
import { createLangChainToolsFromMcp } from "../mcp/langchain-tools.js";

// ─── Configuration ──────────────────────────────────────────────────────────
const MODEL_NAME = "deepseek-r1:7b";
const OLLAMA_BASE_URL = "http://localhost:11434";

// ─── System Prompt (updated for Phase 2) ────────────────────────────────────
const SYSTEM_PROMPT = new SystemMessage(
  "You are a highly capable autonomous AI agent running natively on an Ubuntu Linux system. " +
    "You are in Phase 2 — you now have access to sandboxed tools for file operations, " +
    "terminal execution, web search, and file downloads. " +
    "All file operations and commands are restricted to /home/agent_worker/workspace. " +
    "Use your tools proactively to accomplish tasks. " +
    "Be concise, helpful, and precise."
);

// ─── Build the Graph (async because we fetch MCP tools dynamically) ────────
export async function buildAgentGraph() {
  // 1. Fetch tools from MCP server and create LangChain wrappers
  const tools = await createLangChainToolsFromMcp();

  // 2. Initialize LLM with tools bound
  const llm = new ChatOllama({
    model: MODEL_NAME,
    baseUrl: OLLAMA_BASE_URL,
    temperature: 0.1,
  });
  const llmWithTools = llm.bindTools(tools);

  // 3. Define the Agent Node
  async function callModel(state: typeof MessagesAnnotation.State) {
    const { messages } = state;
    const response = await llmWithTools.invoke([SYSTEM_PROMPT, ...messages]);
    return { messages: [response] };
  }

  // 4. Define the conditional routing function
  function shouldContinue(state: typeof MessagesAnnotation.State) {
    const { messages } = state;
    const lastMessage = messages[messages.length - 1] as AIMessage;
    // If the LLM issued tool calls, route to the tools node
    if (lastMessage?.tool_calls?.length) {
      return "tools";
    }
    // Otherwise, respond to user
    return "__end__";
  }

  // 5. Construct the ReAct state machine
  const workflow = new StateGraph(MessagesAnnotation)
    .addNode("agent", callModel)
    .addNode("tools", new ToolNode(tools))
    .addEdge("__start__", "agent")
    .addConditionalEdges("agent", shouldContinue, ["tools", "__end__"])
    .addEdge("tools", "agent");

  // 6. Compile with memory
  const checkpointer = new MemorySaver();
  return workflow.compile({ checkpointer });
}
```

