### Step 4: Next.js API Route (The Streaming Bridge)

We need an API route to handle incoming HTTP requests from the React frontend, pass them into LangGraph, and stream the generated LLM tokens back to the UI seamlessly. We will transform LangGraph's complex event stream into the standard Vercel AI SDK text stream format.

Create a new file at **`src/app/api/chat/route.ts`**:

```typescript
import { NextRequest } from "next/server";
import { HumanMessage, AIMessage } from "@langchain/core/messages";
import { agentGraph } from "@/lib/agent/graph";

// Allow longer execution times for local inference
export const maxDuration = 60; 

export async function POST(req: NextRequest) {
  try {
    const { messages, threadId } = await req.json();

    // 1. Convert Vercel AI SDK message format to LangChain message classes
    const langchainMessages = messages.map((m: any) =>
      m.role === "user" ? new HumanMessage(m.content) : new AIMessage(m.content)
    );

    // 2. Configure the thread ID for memory persistence
    const config = { configurable: { thread_id: threadId || "dev_thread_001" } };

    // 3. Execute the Graph and listen for real-time streaming events
    const eventStream = await agentGraph.streamEvents(
      { messages: langchainMessages },
      { ...config, version: "v2" }
    );

    // 4. Create a ReadableStream to pipe the tokens back to the client
    const stream = new ReadableStream({
      async start(controller) {
        for await (const { event, data } of eventStream) {
          // Isolate the specific event where the LLM is generating text
          if (event === "on_chat_model_stream" && data.chunk?.content) {
            const textChunk = data.chunk.content;
            // Format chunks using the Vercel AI SDK Data Stream protocol
            controller.enqueue(new TextEncoder().encode(`0:${JSON.stringify(textChunk)}\n`));
          }
        }
        controller.close();
      },
    });

    return new Response(stream, {
      headers: { 
        "Content-Type": "text/x-unknown",
        "x-vercel-ai-data-stream": "v1" 
      },
    });
  } catch (error: any) {
    console.error("Agent execution error:", error);
    return new Response(JSON.stringify({ error: error.message }), { status: 500 });
  }
}

```

